---
import Base from '../../layouts/Base.astro';
import { getCars, carTitle, km, imgUrl } from '../../lib/cars';
import type { Car } from '../../lib/cars';
import { STATUS, PIPELINE } from '../../lib/status';
import { LINE_OA_URL } from '../../consts';

export async function getStaticPaths() {
  const cars = await getCars();
  return cars.map((car) => ({ params: { id: car.id }, props: { car } }));
}

const { car } = Astro.props as { car: Car };
const st = STATUS[car.status] ?? { label: car.status, color: '#777' };
const title = carTitle(car);
const photos = (car.photos ?? []).map((p) => ({ url: imgUrl(p.url)!, caption: p.caption ?? '' }));
const ogImage = photos[0]?.url;
const pIdx = PIPELINE.indexOf(car.status);

const cond: [string, string][] = [];
if (car.vinDisplay) cond.push(['車身號碼 VIN', car.vinDisplay]);
if (car.productionDate) cond.push(['生產日期', car.productionDate]);
const eng = car.engine || (car.displacementCc ? `${car.displacementCc.toLocaleString()} c.c.` : '');
if (eng) cond.push(['引擎', eng]);
if (car.horsepower) cond.push(['最大馬力', `${car.horsepower} hp`]);
const dt = [car.transmission, car.drivetrain].filter(Boolean).join(' · ');
if (dt) cond.push(['變速 / 驅動', dt]);
const tires = car.tires || car.regionSpec;
if (tires) cond.push(['輪胎 / 規格', tires]);

// 規格別（韓規／日規進口）已顯示在標題下方 .sub，這裡不重複；主要資訊維持一排（客戶回饋）
const badges = [
  `${car.modelYear} 年式`,
  km(car.mileageKm),
  car.fuel,
  car.drivetrain,
].filter(Boolean) as string[];

const specEntries = car.spec ? Object.entries(car.spec) : [];
const okUrl = (u?: string | null) => !!u && /^https?:\/\//i.test(u);
---

<Base
  title={`${title}｜橙築國際汽車`}
  description={`${title}・${car.regionSpec ?? ''}進口・${km(car.mileageKm)}。車況透明，附原廠解碼與 Carfax 報告。批發底價僅向已驗證車商於 LINE 內顯示。`}
  ogImage={ogImage}
>
  <article class="detail">
    <div class="container">
      <nav class="crumbs"><a href="/cars">‹ 批發車源</a></nav>

      <div class="gallery">
        {photos.length ? (
          <>
            <div class="hero">
              <img id="heroImg" src={photos[0].url} alt={title} />
              <span class="ov-stat" style={`--st:${st.color}`}>● {st.label}</span>
              {photos.length > 1 && (
                <>
                  <button class="gnav prev" id="gPrev" type="button" aria-label="上一張">‹</button>
                  <button class="gnav next" id="gNext" type="button" aria-label="下一張">›</button>
                  <span class="ov-cnt" id="heroCnt">1 / {photos.length}</span>
                </>
              )}
            </div>
            {photos.length > 1 && (
              <div class="thumbs" id="thumbs">
                {photos.map((p, i) => (
                  <img class={i === 0 ? 'active' : ''} data-i={i} src={p.url} alt={p.caption} loading="lazy" />
                ))}
              </div>
            )}
          </>
        ) : (
          <div class="hero">
            <div class="ph"><span>實車照片陸續更新</span></div>
            <span class="ov-stat" style={`--st:${st.color}`}>● {st.label}</span>
          </div>
        )}
      </div>

      <div class="detail-grid">
        <div class="detail-main">
          <header class="car-head">
            <h1>{title}</h1>
            <p class="sub">
              {car.regionSpec ?? ''}進口{car.exteriorColor ? ` · ${car.exteriorColor}` : ''}{car.interiorColor ? ` / ${car.interiorColor}` : ''}
            </p>
            <div class="badges">{badges.map((b) => <span class="badge">{b}</span>)}</div>
          </header>

          {pIdx >= 0 && car.status !== 'sold' && (
            <section class="sec">
              <h2 class="sec-h">車輛進度</h2>
              <div class="pipe">
                {PIPELINE.map((s, i) => (
                  <div
                    class={`pstep ${i < pIdx ? 'done' : i === pIdx ? 'active' : ''}`}
                    style={i === pIdx ? `--st:${STATUS[s].color}` : ''}
                  >
                    <span class="pdot">{i < pIdx ? '✓' : i === pIdx ? '●' : ''}</span>
                    <span class="pl">{STATUS[s].label}</span>
                  </div>
                ))}
              </div>
            </section>
          )}

          {cond.length > 0 && (
            <section class="sec">
              <h2 class="sec-h">車況 / 車輛資訊</h2>
              <div class="grid2">
                {cond.map(([k, v]) => (
                  <div class="cell"><div class="k">{k}</div><div class="v">{v}</div></div>
                ))}
              </div>
              {car.accidentFree && (
                <div class="verify-row">
                  <span class="ic">✔</span>
                  <span>原廠出廠 · 進口一手 · 無重大事故 · 含 Carfax 與全配備解碼報告</span>
                </div>
              )}
            </section>
          )}

          {car.highlights && car.highlights.length > 0 && (
            <section class="sec">
              <h2 class="sec-h">配備亮點</h2>
              <div class="tags">{car.highlights.map((h) => <span class="tag">{h}</span>)}</div>
            </section>
          )}

          {specEntries.length > 0 && (
            <section class="sec">
              <h2 class="sec-h">原廠規格</h2>
              <table class="spec-tbl">
                <tbody>{specEntries.map(([k, v]) => <tr><td>{k}</td><td>{v}</td></tr>)}</tbody>
              </table>
            </section>
          )}

          {(okUrl(car.decodeUrl) || okUrl(car.carfaxUrl)) && (
            <section class="sec">
              <h2 class="sec-h">車況報告</h2>
              {okUrl(car.decodeUrl) && (
                <a class="doc-link" href={car.decodeUrl!} target="_blank" rel="noopener">
                  <span class="l"><span class="e">📄</span><span>原廠全配備解碼報告<small>outvin · 出廠配備清單</small></span></span>
                  <span class="arr">查看 ›</span>
                </a>
              )}
              {okUrl(car.carfaxUrl) && (
                <a class="doc-link" href={car.carfaxUrl!} target="_blank" rel="noopener">
                  <span class="l"><span class="e">🛡️</span><span>Carfax 車史報告<small>里程 · 事故 · 過戶紀錄</small></span></span>
                  <span class="arr">查看 ›</span>
                </a>
              )}
            </section>
          )}
        </div>

        <aside class="detail-side">
          <div class="dealer-cta card">
            <span class="lk">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="4" y="10" width="16" height="11" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" />
              </svg>
            </span>
            <div class="lt">批發底價僅限已驗證車商</div>
            <p class="ls">
              加入官方帳號、通過車商審核後，即可在 LINE 內查看這台車的批發底價、建議零售與利潤空間，並線上下訂鎖車。
            </p>
            <a class="btn btn-primary btn-lg" href={LINE_OA_URL} target="_blank" rel="noopener">加 LINE 看批發價</a>
            <a class="btn btn-ghost" href={LINE_OA_URL} target="_blank" rel="noopener">直接詢價</a>
            <a class="dealer-link" href="/dealer">如何成為車商 ›</a>
          </div>
        </aside>
      </div>
    </div>
  </article>
</Base>

<script>
  const hero = document.getElementById('heroImg') as HTMLImageElement | null;
  const cnt = document.getElementById('heroCnt');
  const thumbs = document.getElementById('thumbs');
  const imgs = thumbs ? Array.from(thumbs.querySelectorAll<HTMLImageElement>('img')) : [];
  const n = imgs.length;

  if (hero && n > 1) {
    let idx = 0;
    const show = (i: number) => {
      idx = (i + n) % n; // 環狀：最後一張再下一張回到第一張
      hero.src = imgs[idx].src;
      imgs.forEach((t, k) => t.classList.toggle('active', k === idx));
      if (cnt) cnt.textContent = `${idx + 1} / ${n}`;
      imgs[idx].scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'smooth' });
    };

    document.getElementById('gPrev')?.addEventListener('click', () => show(idx - 1));
    document.getElementById('gNext')?.addEventListener('click', () => show(idx + 1));
    thumbs!.addEventListener('click', (e) => {
      const t = e.target as HTMLImageElement;
      if (t.tagName === 'IMG') show(imgs.indexOf(t));
    });

    // 鍵盤左右鍵切換
    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(idx - 1);
      else if (e.key === 'ArrowRight') show(idx + 1);
    });

    // 觸控左右滑（左滑＝下一張）
    const box = hero.parentElement;
    let x0: number | null = null;
    box?.addEventListener('touchstart', (e) => { x0 = (e as TouchEvent).touches[0].clientX; }, { passive: true });
    box?.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = (e as TouchEvent).changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 40) show(idx + (dx < 0 ? 1 : -1));
      x0 = null;
    }, { passive: true });
  }
</script>
