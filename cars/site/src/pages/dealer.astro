---
import Base from '../layouts/Base.astro';
import { LINE_OA_URL } from '../consts';
import { getCars, cover, carTitle } from '../lib/cars';
import { STATUS } from '../lib/status';

const cars = await getCars();
const withPhotos = cars.filter((c) => c.photos?.length);
const showcase = withPhotos[2] ?? withPhotos[0];
const showcaseSt = showcase ? STATUS[showcase.status] : null;

const steps = [
  { n: '1', t: '加入官方帳號', d: '用手機加入橙築車商批發 LINE 官方帳號。' },
  { n: '2', t: '線上填申請', d: '在 LINE 內的「會員專區」填寫車商資料，上傳名片或營登照片。' },
  { n: '3', t: '資格審核', d: '我們確認車商身分，通常 1 個工作天內完成。' },
  { n: '4', t: '開通批發專區', d: '審核通過後，所有車源的批發底價自動對你解鎖。' },
];

const perks = [
  '查看每台車的批發底價、建議零售與利潤空間',
  '線上下訂鎖車，保留車輛、安排訂金與排船',
  '各階段車源即時掌握（預訂 / 船運 / 報關 / 車測 / 現車）',
  '專人報價與交車安排，問題直接在 LINE 對話',
];
---

<Base
  title="成為車商｜橙築國際汽車"
  description="加入橙築車商批發官方帳號、完成車商驗證，即可在 LINE 內查看批發底價、線上下訂鎖車。申請流程簡單，通常 1 個工作天內完成審核。"
>
  <section class="section page-hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">車商專區</span>
        <h1>成為車商，<br /><span class="gold">解鎖批發底價</span></h1>
        <p class="lede">
          橙築的批發底價只向通過驗證的車商開放。完成簡單的線上申請與審核後，
          你就能在 LINE 內看到每台車的批發價、利潤空間，並直接線上下訂鎖車。
        </p>
        <div class="hero-cta">
          <a class="btn btn-line btn-lg" href={LINE_OA_URL} target="_blank" rel="noopener">立即加入官方帳號</a>
          <a class="btn btn-ghost btn-lg" href="/cars">瀏覽車源</a>
        </div>
        <p class="hero-note">批發底價僅向通過審核的車商顯示</p>
      </div>
      {showcase && cover(showcase) && (
        <a class="hero-feature" href={`/cars/${showcase.id}`} aria-label={carTitle(showcase)}>
          <img src={cover(showcase)} alt={carTitle(showcase)} />
          <div class="hf-overlay">
            {showcaseSt && <span class="ov-stat" style={`--st:${showcaseSt.color}`}>● {showcaseSt.label}</span>}
            <span class="hf-name">{carTitle(showcase)}</span>
          </div>
        </a>
      )}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">申請流程</span>
      <h2 class="block-h">四步驟，最快當天開通</h2>
      <div class="steps">
        {steps.map((s) => (
          <div class="step card">
            <div class="step-n">{s.n}</div>
            <div>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="split">
        <div>
          <span class="eyebrow">車商權益</span>
          <h2 class="block-h">通過驗證後你能做的事</h2>
          <ul class="ticks">
            {perks.map((p) => <li>{p}</li>)}
          </ul>
        </div>
        <div class="apply-card card">
          <h3>準備好了嗎？</h3>
          <p>申請只需要名片或營登照片，流程都在 LINE 內完成，不需另外註冊帳號。</p>
          <a class="btn btn-line btn-lg" href={LINE_OA_URL} target="_blank" rel="noopener">加入官方帳號開始申請</a>
          <a class="btn btn-ghost" href="/cars">先瀏覽批發車源</a>
        </div>
      </div>
    </div>
  </section>
</Base>
