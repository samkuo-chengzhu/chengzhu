---
import Base from '../layouts/Base.astro';
import CarCard from '../components/CarCard.astro';
import { getCars, cover, carTitle } from '../lib/cars';
import { STATUS } from '../lib/status';
import { LINE_OA_URL } from '../consts';

const cars = await getCars();
const featured = cars.slice(0, 6);
// Hero 主打：優先現車在庫、且有照片的一台
const heroCar =
  cars.find((c) => c.status === 'in_stock' && c.photos?.length) ??
  cars.find((c) => c.photos?.length) ??
  cars[0];
const heroImg = heroCar ? cover(heroCar) : null;
const heroSt = heroCar ? STATUS[heroCar.status] : null;
---

<Base>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">日本・韓國原裝進口</span>
        <h1>進口好車，<br /><span class="gold">車商專屬批發</span></h1>
        <p class="lede">
          橙築國際汽車直送日本、韓國原裝好車。車況透明、附原廠解碼與 Carfax 報告；
          通過驗證的車商可在 LINE 內查看批發底價、線上下訂鎖車。
        </p>
        <div class="hero-cta">
          <a class="btn btn-primary btn-lg" href="/cars">瀏覽批發車源</a>
          <a class="btn btn-ghost btn-lg" href="/dealer">成為車商</a>
        </div>
        <p class="hero-note">批發底價僅向通過審核的車商顯示</p>
      </div>

      {heroCar && heroImg && (
        <a class="hero-feature" href={`/cars/${heroCar.id}`} aria-label={carTitle(heroCar)}>
          <img src={heroImg} alt={carTitle(heroCar)} />
          <div class="hf-overlay">
            {heroSt && <span class="ov-stat" style={`--st:${heroSt.color}`}>● {heroSt.label}</span>}
            <span class="hf-name">{carTitle(heroCar)}</span>
          </div>
        </a>
      )}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">為什麼選橙築</span>
      <div class="value-grid">
        <article class="value">
          <span class="vic">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 14.5l1.7 4.8a2 2 0 0 0 1.9 1.3h10.8a2 2 0 0 0 1.9-1.3L21 14.5" />
              <path d="M4 14.5 12 12l8 2.5" /><path d="M12 12V5" /><path d="M12 5h4l-1.4 2L16 9h-4" />
            </svg>
          </span>
          <h3>進口直送</h3>
          <p>日本、韓國原裝車源，自船運、報關、車測到交車全程掌握，價格更有競爭力。</p>
        </article>
        <article class="value">
          <span class="vic">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3l7 3v5c0 4.4-3 7.6-7 9-4-1.4-7-4.6-7-9V6l7-3z" /><path d="M9 12l2 2 4-4" />
            </svg>
          </span>
          <h3>車況透明</h3>
          <p>每台附實車照片、完整規格與原廠解碼／Carfax 報告，里程與事故紀錄清楚可查。</p>
        </article>
        <article class="value">
          <span class="vic">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.5 13.3l-7.2 7.2a1.5 1.5 0 0 1-2.1 0l-7.7-7.7V4.5a1 1 0 0 1 1-1h8.3z" /><circle cx="8" cy="8" r="1.3" />
            </svg>
          </span>
          <h3>批發底價</h3>
          <p>通過驗證的車商，在 LINE 內即可解鎖批發底價、查看建議零售與利潤，並線上鎖車。</p>
        </article>
      </div>
    </div>
  </section>

  {featured.length > 0 && (
    <section class="section pt0">
      <div class="container">
        <div class="row-head">
          <span class="eyebrow">最新車源</span>
          <a class="more" href="/cars">查看全部 ›</a>
        </div>
        <div class="car-grid">
          {featured.map((car) => <CarCard car={car} />)}
        </div>
      </div>
    </section>
  )}

  <section class="cta-band">
    <div class="container">
      <h2>想取得批發底價？</h2>
      <p>加入官方帳號、完成車商驗證，立即解鎖所有車源的批發價與線上下訂。</p>
      <div class="cta-row">
        <a class="btn btn-primary btn-lg" href="/dealer">成為車商</a>
        <a class="btn btn-line btn-lg" href={LINE_OA_URL} target="_blank" rel="noopener">加入官方帳號</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    padding-block: clamp(28px, 4vw, 56px);
    background:
      radial-gradient(60% 90% at 78% 30%, rgba(205, 168, 92, .12), transparent 60%),
      linear-gradient(180deg, #0d0d10, var(--bg));
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }
  .hero h1 { font-size: clamp(32px, 5vw, 56px); margin-top: 16px; letter-spacing: 1px; line-height: 1.14; }
  .lede { margin-top: 20px; font-size: clamp(15px, 1.6vw, 17px); color: var(--muted); max-width: 52ch; line-height: 1.85; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 30px; }
  .hero-note { margin-top: 15px; font-size: 12.5px; color: var(--muted2); }

  .hero-feature {
    position: relative; display: block; border-radius: 18px; overflow: hidden;
    border: 1px solid var(--gold-deep); aspect-ratio: 4 / 3;
    background: linear-gradient(160deg, #17171c, #0c0c0f);
    box-shadow: 0 30px 70px -28px rgba(0, 0, 0, .8);
    transition: transform .25s ease;
  }
  .hero-feature:hover { transform: translateY(-4px); }
  .hero-feature img { width: 100%; height: 100%; object-fit: cover; }
  .hf-overlay {
    position: absolute; inset: auto 0 0 0; padding: 18px;
    display: flex; flex-direction: column; align-items: flex-start; gap: 9px;
    background: linear-gradient(0deg, rgba(0, 0, 0, .82), rgba(0, 0, 0, .2) 60%, transparent);
  }
  .hf-name { font-size: 16px; font-weight: 700; color: #fff; letter-spacing: .3px; }

  .value-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 26px; }
  .value {
    padding: 24px 22px; background: var(--surface); border: 1px solid var(--line);
    border-radius: 14px; transition: border-color .2s, transform .2s;
  }
  .value:hover { border-color: var(--gold-deep); transform: translateY(-3px); }
  .vic {
    display: inline-grid; place-items: center; width: 46px; height: 46px; border-radius: 11px;
    color: var(--gold-bright); background: rgba(205, 168, 92, .1); border: 1px solid var(--gold-deep);
  }
  .vic svg { width: 24px; height: 24px; }
  .value h3 { font-size: 18px; margin-top: 16px; }
  .value p { margin-top: 9px; color: var(--muted); font-size: 14px; line-height: 1.8; }

  .pt0 { padding-top: 0; }
  .row-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22px; }
  .row-head .more { color: var(--gold-bright); font-size: 14px; font-weight: 700; }

  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; gap: 32px; }
    .hero-feature { max-width: 560px; }
  }
  @media (max-width: 768px) {
    .value-grid { grid-template-columns: 1fr; }
  }
  /* 手機版：hero 頂部再收窄，主打車照往上移、不被擠到底部（客戶回饋 2026-06：紅框再往上移一點） */
  @media (max-width: 560px) {
    .hero { padding-block: 8px 12px; }
    .hero h1 { margin-top: 10px; }
    .lede { margin-top: 14px; }
    .hero-cta { margin-top: 18px; }
    .hero-note { margin-top: 10px; }
    .hero-grid { gap: 20px; }
  }
</style>
