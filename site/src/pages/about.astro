---
import Base from '../layouts/Base.astro';
import { LINE_OA_URL } from '../consts';
import { getCars, cover, carTitle } from '../lib/cars';
import { STATUS } from '../lib/status';

const cars = await getCars();
const withPhotos = cars.filter((c) => c.photos?.length);
const showcase = withPhotos[1] ?? withPhotos[0];
const showcaseSt = showcase ? STATUS[showcase.status] : null;

const flow = [
  { n: '01', t: '海外標車', d: '在日本、韓國拍賣場與車源網絡精選車況良好、配備齊全的車。' },
  { n: '02', t: '海運排船', d: '安排船期、海運與保險，全程掌握到港時程。' },
  { n: '03', t: '進口報關', d: '處理關稅、貨物稅與進口文件，合法清關。' },
  { n: '04', t: '車測驗車', d: '通過 ARTC / 監理驗車，確保符合台灣法規上路標準。' },
  { n: '05', t: '交車過戶', d: '完成領牌、過戶，車況報告與文件一併交付。' },
];
---

<Base
  title="關於橙築｜橙築國際汽車"
  description="橙築國際汽車專注日本・韓國原裝進口車的批發與代辦，從海外標車、海運、報關、車測到交車一條龍，車況透明、價格實在。"
>
  <section class="section page-hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">關於我們</span>
        <h1>專注進口車批發的<br /><span class="gold">一條龍夥伴</span></h1>
        <p class="lede">
          橙築國際汽車（ORANGE BUILDING MOTOR）長期經營日本、韓國原裝進口車。
          我們直接掌握海外車源、自辦海運與報關，讓每一台車的車況與成本都透明，
          提供車商穩定、有競爭力的批發底價。
        </p>
        <div class="hero-cta">
          <a class="btn btn-line btn-lg" href={LINE_OA_URL} target="_blank" rel="noopener">加入官方帳號</a>
          <a class="btn btn-ghost btn-lg" href="/cars">瀏覽車源</a>
        </div>
      </div>
      {showcase && cover(showcase) && (
        <a class="hero-feature" href={`/cars/${showcase.id}`} aria-label={carTitle(showcase)}>
          <img src={cover(showcase)} alt={carTitle(showcase)} />
          <div class="hf-overlay">
            {showcaseSt && <span class="ov-stat" style={`--st:${showcaseSt.color}`}>● {showcaseSt.label}</span>}
            <span class="hf-name">{carTitle(showcase)}</span>
          </div>
        </a>
      )}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">進口一條龍</span>
      <h2 class="block-h">從海外到交車，全程自辦</h2>
      <div class="flow">
        {flow.map((s) => (
          <div class="flow-step card">
            <div class="flow-n">{s.n}</div>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="split">
        <div>
          <span class="eyebrow">為什麼選進口</span>
          <h2 class="block-h">同樣預算，更好的車</h2>
          <p class="para">
            日本、韓國車源普遍保養良好、配備更高，原裝進口在配備等級與車況上往往比國內同級更有優勢；
            透過直送批發，車商能用更有競爭力的成本取得熱門車款。
          </p>
        </div>
        <div>
          <span class="eyebrow">給車商的價值</span>
          <h2 class="block-h">穩定車源 · 透明車況</h2>
          <ul class="ticks">
            <li>固定且透明的批發底價（僅向已驗證車商顯示）</li>
            <li>每台附實車照片、原廠解碼與 Carfax 報告</li>
            <li>各階段車源（預訂 / 船運 / 報關 / 車測 / 現車）即時掌握</li>
            <li>線上下訂鎖車，後續訂金與排船由專人對接</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container">
      <h2>想取得批發底價？</h2>
      <p>加入官方帳號、完成車商驗證，立即解鎖所有車源的批發價與線上下訂。</p>
      <div class="cta-row">
        <a class="btn btn-primary btn-lg" href="/dealer">成為車商</a>
        <a class="btn btn-ghost btn-lg" href="/cars">先看看車源</a>
      </div>
    </div>
  </section>
</Base>
